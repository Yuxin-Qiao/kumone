{
  "name": "kumone",
  "productName": "Kumone",
  "version": "0.1.9",
  "description": "Kumone — NetEase Cloud Music client for Windows & Linux (Electron port of missuo/kumone)",
  "homepage": "https://github.com/Yuxin-Qiao/kumone",
  "main": "main.js",
  "author": "Yuxin Qiao <qiaoyuxin123@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node test/unit.js && node test/smoke.js",
    "test:unit": "node test/unit.js",
    "e2e": "node test/e2e.js",
    "package:win": "electron-builder --win nsis --x64 --config build/eb-config.json --publish never",
    "package:linux": "electron-builder --linux --x64 --config build/eb-config.json --publish never"
  },
  "devDependencies": {
    "@electron/asar": "^4.2.1",
    "electron": "^31.7.0",
    "electron-builder": "^26.15.3",
    "electron-packager": "^17.1.2",
    "playwright-core": "^1.62.1",
    "png-to-ico": "^3.0.2"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  }
}
